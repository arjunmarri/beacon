# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional GitHub OAuth App credentials for popup-based Git account sync & repo permissions.
# Callback URL: <APP_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional GitHub Personal Access Token (server-side only) for automatic non-interactive Git auth.
GITHUB_TOKEN=

# Optional Anthropic Claude API Key (server-side only) for automatic Claude API health checking.
ANTHROPIC_API_KEY=

# Optional SMTP password for automated email notifications on server crash or redeploy.
# Configure SMTP host, port, user, and recipient directly in the Beacon dashboard.
SMTP_PASS=

# Optional shared secret to authenticate incoming Git push webhooks (X-Beacon-Webhook-Token header).
GIT_WEBHOOK_SECRET=
